# ===== Gemini（情報収集・執筆・読み取り・翻訳の全部に使う） =====
# キーは https://aistudio.google.com/apikey で発行。3リポジトリ共通なら Windows に一度だけ:
#   setx GEMINI_API_KEY "キー"   （この .env を空のままにすると Windows の値が使われる）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 用途ごとに変える場合だけ（空なら上の共通モデル）: research / write / translate / ocr / extract / fast
GEMINI_MODEL_WRITE=
GEMINI_MODEL_RESEARCH=
# 安全フィルタで止まりやすい内容（写メ日記・成人向け翻訳）なら relaxed
GEMINI_SAFETY=
# 特定の用途だけ OpenRouter にする場合（例: 翻訳）
LLM_PROVIDER_TRANSLATE=
OPENROUTER_API_KEY=
OPENROUTER_MODEL_TRANSLATE=
# スプレッドシート
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
# 通知（使うものだけ）
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
CHATWORK_TOKEN=
CHATWORK_ROOM_ID=
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=
# API（serve）を外から叩く場合のトークン（空なら認証なし）
OW_API_TOKEN=
# 受託自動実装エンジン: openhands / claude / opencode（空なら自動検出）
CODING_AGENT=
OPENHANDS_MODEL=
OPENHANDS_MAX_STEPS=80
# 写メ日記（事業1）: LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
DIARY_DIR=diary_data
